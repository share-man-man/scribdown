{
  "name": "@scribdown/ui-handdrawn",
  "version": "0.2.2",
  "description": "Scribdown 手绘风格视觉组件：设计 Token、样式与 SVG 资产。",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/share-man-man/scribdown.git",
    "directory": "packages/ui-handdrawn"
  },
  "exports": {
    "./styles.css": "./src/styles.css",
    "./styles/*": "./src/styles/*",
    "./assets/*": "./src/assets/*"
  },
  "files": [
    "src/styles.css",
    "src/styles",
    "src/assets"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "test": "vitest run --passWithNoTests",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "gen:rough-lines": "node scripts/generate-rough-lines.mjs"
  },
  "devDependencies": {
    "roughjs": "^4.6.6",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  }
}
