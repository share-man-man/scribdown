{
  "name": "scribdown-markdown-preview",
  "displayName": "%displayName%",
  "description": "%description%",
  "publisher": "ShareManMan",
  "version": "0.7.1",
  "private": true,
  "type": "module",
  "main": "dist/extension.cjs",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/share-man-man/scribdown.git",
    "directory": "apps/vscode-extension"
  },
  "categories": [
    "Other"
  ],
  "icon": "assets/icon.png",
  "engines": {
    "vscode": "^1.90.0"
  },
  "activationEvents": [
    "onCommand:scribdown.openPreview"
  ],
  "files": [
    "dist/**",
    "assets/**",
    "package.json",
    "package.nls.json",
    "package.nls.*.json",
    "LICENSE"
  ],
  "contributes": {
    "commands": [
      {
        "command": "scribdown.openPreview",
        "title": "%command.openPreview.title%",
        "category": "Scribdown",
        "icon": {
          "light": "assets/icon.svg",
          "dark": "assets/icon.svg"
        }
      }
    ],
    "configuration": {
      "title": "Scribdown",
      "properties": {
        "scribdown.language": {
          "type": "string",
          "enum": [
            "en",
            "zh-CN",
            "zh-TW",
            "ja",
            "ko",
            "es",
            "fr",
            "de",
            "pt-BR",
            "ru"
          ],
          "markdownDescription": "%configuration.language.description%",
          "enumDescriptions": [
            "%configuration.language.english.description%",
            "%configuration.language.simplifiedChinese.description%",
            "%configuration.language.traditionalChinese.description%",
            "%configuration.language.japanese.description%",
            "%configuration.language.korean.description%",
            "%configuration.language.spanish.description%",
            "%configuration.language.french.description%",
            "%configuration.language.german.description%",
            "%configuration.language.brazilianPortuguese.description%",
            "%configuration.language.russian.description%"
          ],
          "scope": "window"
        }
      }
    },
    "menus": {
      "editor/title": [
        {
          "command": "scribdown.openPreview",
          "when": "resourceLangId == markdown || resourceExtname == .md",
          "group": "navigation"
        }
      ],
      "editor/context": [
        {
          "command": "scribdown.openPreview",
          "when": "resourceLangId == markdown || resourceExtname == .md",
          "group": "navigation"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "pnpm run build",
    "dev": "tsup --watch",
    "build": "tsup",
    "package:vsix": "node ../../scripts/vsce.mjs package --out scribdown-markdown-preview.vsix",
    "publish:vsix": "node ../../scripts/vsce.mjs publish",
    "test": "vitest run --passWithNoTests",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@scribdown/markdown-renderer": "workspace:*",
    "@scribdown/shared": "workspace:*",
    "@scribdown/ui-handdrawn": "workspace:*"
  },
  "devDependencies": {
    "@types/vscode": "^1.90.0",
    "esbuild": "^0.25.11",
    "morphdom": "^2.7.5",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  }
}
