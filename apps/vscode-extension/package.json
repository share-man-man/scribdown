{
  "name": "scribdown-markdown-preview",
  "displayName": "Scribdown Markdown Preview",
  "description": "Handdrawn-style Markdown preview for VS Code.",
  "publisher": "scribdown",
  "version": "0.0.0",
  "type": "module",
  "main": "dist/extension.cjs",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/share-man-man/scribdown.git",
    "directory": "apps/vscode-extension"
  },
  "categories": [
    "Other"
  ],
  "icon": "assets/icon.png",
  "engines": {
    "vscode": "^1.90.0"
  },
  "activationEvents": [
    "onCommand:scribdown.openPreview"
  ],
  "files": [
    "dist/**",
    "assets/**",
    "package.json",
    "LICENSE"
  ],
  "contributes": {
    "commands": [
      {
        "command": "scribdown.openPreview",
        "title": "Open Scribdown Preview",
        "category": "Scribdown",
        "icon": {
          "light": "assets/icon.svg",
          "dark": "assets/icon.svg"
        }
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "scribdown.openPreview",
          "when": "resourceLangId == markdown",
          "group": "navigation"
        }
      ],
      "editor/context": [
        {
          "command": "scribdown.openPreview",
          "when": "resourceLangId == markdown",
          "group": "navigation"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "pnpm run build",
    "dev": "tsup --watch",
    "build": "tsup",
    "package:vsix": "pnpm dlx @vscode/vsce package --no-dependencies --out scribdown-markdown-preview.vsix",
    "test": "vitest run",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@scribdown/markdown-renderer": "workspace:*",
    "@scribdown/shared": "workspace:*",
    "@scribdown/ui-handdrawn": "workspace:*",
    "@types/vscode": "^1.90.0",
    "esbuild": "^0.25.11",
    "morphdom": "^2.7.5",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  }
}
