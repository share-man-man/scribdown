{
  "name": "scribdown",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "dev:packages": "turbo run dev --filter='./packages/*' --filter='./tools/*'",
    "dev:apps": "turbo run dev --filter='./apps/*'",
    "dev": "turbo watch dev",
    "build": "turbo run build",
    "test": "turbo run test",
    "e2e": "playwright test",
    "lint": "turbo run lint",
    "format": "prettier --write .",
    "typecheck": "turbo run typecheck",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "changeset publish",
    "clean": "find . \\( -name node_modules -o -name dist -o -name .turbo \\) -type d -prune -exec rm -rf {} +"
  },
  "devDependencies": {
    "@changesets/cli": "^2.29.5",
    "@eslint/js": "^9.32.0",
    "@playwright/test": "^1.54.2",
    "@types/node": "^24",
    "eslint": "^9.32.0",
    "prettier": "^3.6.2",
    "roughjs": "^4.6.6",
    "tsup": "^8.5.1",
    "turbo": "^2.5.4",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.59.2",
    "vitest": "^3.2.4"
  }
}