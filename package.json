{
  "name": "scribdown",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@11.4.0",
  "engines": {
    "node": "24.18.0",
    "pnpm": "11.4.0"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "test": "turbo run test",
    "e2e": "playwright test",
    "lint": "turbo run lint",
    "format": "prettier --write .",
    "typecheck": "turbo run typecheck",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "pnpm -r --filter \"./packages/*\" build && changeset publish",
    "clean": "find . \\( -name node_modules -o -name dist -o -name .turbo \\) -type d -prune -exec rm -rf {} +",
    "build:icons": "bash scripts/build-icons.sh",
    "sync:i18n": "pnpm --filter @scribdown/shared build && node scripts/sync-i18n-manifests.mjs"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.1",
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.62.0",
    "@types/node": "^24.13.3",
    "eslint": "^9.39.5",
    "globals": "^17.7.0",
    "prettier": "^3.9.6",
    "roughjs": "^4.6.6",
    "tsup": "^8.5.1",
    "turbo": "^2.10.7",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.65.0",
    "vitest": "^3.2.7"
  }
}
